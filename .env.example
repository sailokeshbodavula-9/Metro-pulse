# GEMINI_API_KEY: Required for Gemini AI API calls (add your real AIza... key in Vercel/AI Studio Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://metro-pulse-two.vercel.app/"

# MONGO_URI: Optional MongoDB connection string for Time Series persistence.
# Set your real Atlas URI in Vercel Environment Variables (never commit secrets here).
MONGO_URI=""

# VITE_BACKEND_URL: Optional persistent Node/Socket.IO server URL when splitting frontend & backend.
VITE_BACKEND_URL=""
